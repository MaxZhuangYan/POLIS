# Copy to .env.local (gitignored) and fill in what you need. Every variable is optional.

# ── model (any OpenAI-compatible /v1/chat/completions endpoint) ─────────────────────────────
# Without a reachable model the game runs on its rule engine and says so in the HUD.
POLIS_LLM_URL=http://127.0.0.1:1234/v1/chat/completions
POLIS_LLM_MODEL=qwen/qwen3.6-35b-a3b
POLIS_LLM_API_KEY=
# Hosted endpoints often cap parallel requests; calls queue here instead of failing.
POLIS_LLM_CONCURRENCY=3
# POLIS_LLM=off forces the rule engine (no probing). Older names still work: LMSTUDIO_URL, LMSTUDIO_MODEL.
# POLIS_LLM=off

# ── world ───────────────────────────────────────────────────────────────────────────────────
# Save file (default ./polis.db). `npm run dev:test` uses ./polis-test.db.
# POLIS_DB_PATH=./polis.db
# 1 = labelled test fast-forward (/api/test/advance, the bottom-left panel, /dev/town).
# POLIS_TEST_MODE=1
# World time zone fallback (the browser's zone is used when the Agent is created).
# POLIS_TZ=Asia/Shanghai
# Distillation catch-up batch interval (ms).
# DISTILLATION_INTERVAL_MS=60000

# ── client / build ──────────────────────────────────────────────────────────────────────────
# Which registered map to play (app/components/town/maps.ts); baked in at build time.
# NEXT_PUBLIC_POLIS_MAP=polis-town
# Build output dir (lets several builds coexist; scripts use it).
# NEXT_DIST_DIR=.next
